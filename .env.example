# Copy this file to .env and fill in real values.
# Used by docker-compose.yml (Postgres) and by backend/app/config.py (pydantic-settings).

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Default: claude-opus-5 (best reasoning for "decide what charts/insights matter").
# Cheaper swaps with no code change: claude-sonnet-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# --- Langfuse (tracing/observability) ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database ---
POSTGRES_USER=arg_user
POSTGRES_PASSWORD=arg_password
POSTGRES_DB=arg_db
# Host is "localhost" when the backend runs on your machine and Postgres runs in Docker
# with its port published (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://arg_user:arg_password@localhost:5432/arg_db

# --- Local file storage (paths are relative to backend/ unless absolute) ---
UPLOAD_DIR=storage/uploads
CHART_DIR=storage/charts
REPORT_DIR=storage/reports

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- CORS ---
# The Next.js frontend's default dev port.
FRONTEND_ORIGIN=http://localhost:3000
