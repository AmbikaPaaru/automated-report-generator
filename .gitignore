# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
backend/uv.lock.tmp

# --- Runtime data (never commit uploaded files or generated artifacts) ---
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/charts/*
!backend/storage/charts/.gitkeep
backend/storage/reports/*
!backend/storage/reports/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# --- Env / secrets ---
.env
.env.*
!.env.example
!frontend/.env.example

# --- Node / frontend ---
node_modules/
dist/
frontend/.vite/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
